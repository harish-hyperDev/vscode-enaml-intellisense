{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Enaml",
  "scopeName": "source.enaml",
  "fileTypes": [
    "enaml"
  ],
  "patterns": [
    {
      "include": "#enamldef"
    },
    {
      "include": "#function"
    },
    {
      "include": "#override"
    },
    {
      "include": "#storage"
    },
    {
      "include": "#alias"
    },
    {
      "include": "#component"
    },
    {
      "include": "#template-call"
    },
    {
      "include": "#binding"
    },
    {
      "include": "source.python"
    }
  ],
  "repository": {
    "enamldef": {
      "name": "meta.class.enaml",
      "begin": "^\\s*(enamldef)\\s+([A-Za-z_]\\w*)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "storage.type.class.enaml"
        },
        "2": {
          "name": "entity.name.type.class.enaml"
        },
        "3": {
          "name": "punctuation.definition.inheritance.begin.enaml"
        }
      },
      "end": "(\\))\\s*(:)(?:\\s*([A-Za-z_]\\w*)\\s*(:))?|(?=#)|$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.inheritance.end.enaml"
        },
        "2": {
          "name": "punctuation.section.class.begin.enaml"
        },
        "3": {
          "name": "variable.language.enaml"
        },
        "4": {
          "name": "punctuation.section.class.begin.enaml"
        }
      },
      "patterns": [
        {
          "match": "[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*",
          "name": "entity.other.inherited-class.enaml"
        }
      ]
    },
    "function": {
      "name": "meta.function.enaml",
      "begin": "^\\s*(template|func)\\s+([A-Za-z_]\\w*)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "storage.type.function.enaml"
        },
        "2": {
          "name": "entity.name.function.enaml"
        },
        "3": {
          "name": "punctuation.definition.parameters.begin.enaml"
        }
      },
      "end": "(\\))\\s*(?:(->)\\s*([^:#]+))?\\s*(:)|(?=#)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.parameters.end.enaml"
        },
        "2": {
          "name": "keyword.operator.enaml"
        },
        "3": {
          "name": "entity.name.type.enaml"
        },
        "4": {
          "name": "punctuation.section.function.begin.enaml"
        }
      },
      "patterns": [
        {
          "include": "#parameters"
        }
      ]
    },
    "override": {
      "name": "meta.function.enaml",
      "begin": "^\\s+([A-Za-z_]\\w*)\\s*(=>)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.enaml"
        },
        "2": {
          "name": "keyword.operator.enaml"
        },
        "3": {
          "name": "punctuation.definition.parameters.begin.enaml"
        }
      },
      "end": "(\\))\\s*(:)|(?=#)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.parameters.end.enaml"
        },
        "2": {
          "name": "punctuation.section.function.begin.enaml"
        }
      },
      "patterns": [
        {
          "include": "#parameters"
        }
      ]
    },
    "parameters": {
      "patterns": [
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {
              "include": "#parameters"
            }
          ]
        },
        {
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        },
        {
          "include": "source.python"
        }
      ]
    },
    "storage": {
      "match": "^\\s+(attr|event|const)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "storage.modifier.enaml"
        },
        "2": {
          "name": "entity.other.attribute-name.enaml"
        }
      }
    },
    "alias": {
      "match": "^\\s+(alias)\\s+([A-Za-z_]\\w*)(?:\\s*(:)\\s*([A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*))?",
      "captures": {
        "1": {
          "name": "storage.modifier.enaml"
        },
        "2": {
          "name": "entity.other.attribute-name.enaml"
        },
        "3": {
          "name": "punctuation.separator.enaml"
        },
        "4": {
          "name": "variable.other.enaml"
        }
      }
    },
    "component": {
      "match": "^\\s+(?!(?:else|try|finally|except)\\b)([A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*)\\s*(:)(?:\\s*([A-Za-z_]\\w*)\\s*(:))?\\s*(?=#|$)",
      "captures": {
        "1": {
          "name": "entity.name.tag.enaml"
        },
        "2": {
          "name": "punctuation.section.class.begin.enaml"
        },
        "3": {
          "name": "variable.language.enaml"
        },
        "4": {
          "name": "punctuation.section.class.begin.enaml"
        }
      }
    },
    "template-call": {
      "name": "meta.function-call.enaml",
      "begin": "^\\s+([A-Za-z_]\\w*)\\s*(\\()(?=.*\\)\\s*(?::|[A-Za-z_*]))",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.enaml"
        },
        "2": {
          "name": "punctuation.definition.arguments.begin.enaml"
        }
      },
      "end": "(\\))\\s*(?:(:)\\s*([A-Za-z_*][\\w*, \\t]*)\\s*)?(:)\\s*(?=#|$)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.arguments.end.enaml"
        },
        "2": {
          "name": "punctuation.separator.enaml"
        },
        "3": {
          "name": "variable.language.enaml"
        },
        "4": {
          "name": "punctuation.section.class.begin.enaml"
        }
      },
      "patterns": [
        {
          "include": "#parameters"
        }
      ]
    },
    "binding": {
      "match": "^\\s+([A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*)\\s*(<<|>>|:=|::|=(?!=))",
      "captures": {
        "1": {
          "name": "entity.other.attribute-name.enaml"
        },
        "2": {
          "name": "keyword.operator.enaml"
        }
      }
    }
  }
}
